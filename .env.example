# --- Base de données / Redis ---
DATABASE_URL=postgres://platform:platform@localhost:5432/platform
REDIS_URL=redis://localhost:6379

# --- Chiffrement des secrets (tokens Portainer, GitHub, webhooks...) ---
# Clé maîtresse AES-256 en base64 (32 octets) : `openssl rand -base64 32`
# En production, préférer MASTER_KEY_FILE pointant vers un secret Docker.
MASTER_KEY=
MASTER_KEY_FILE=
MASTER_KEY_ID=k1
# Anciennes clés pour la rotation : "k0:base64,k-1:base64"
MASTER_KEYS_PREVIOUS=

# --- Adaptateurs : mock | http ---
PORTAINER_ADAPTER=mock
RUNNER_ADAPTER=mock

# --- Target Runner : identité mTLS de la plateforme (certificat client) ---
RUNNER_CLIENT_CERT_FILE=
RUNNER_CLIENT_KEY_FILE=

# --- Archives ZIP ---
UPLOAD_DIR=.data/uploads
UPLOAD_MAX_MB=512
ZIP_MAX_FILES=20000

# --- Sources GitHub : API autorisées (github.com, GitHub Enterprise) ---
GITHUB_ALLOWED_API_URLS=https://api.github.com

# --- Ollama (analyse de logs) : l'adresse, le modèle et le jeton se règlent dans Administration → Ollama ---
# OLLAMA_ADAPTER=mock simule les réponses (sans serveur Ollama) ; OLLAMA_MAX_CONCURRENT borne les analyses simultanées.
OLLAMA_ADAPTER=http
OLLAMA_MAX_CONCURRENT=2

# --- Authentification ---
APP_URL=http://localhost:3000
SESSION_IDLE_MIN=60
SESSION_MAX_HOURS=12
COOKIE_SECURE=true
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MIN=15

# --- Développement uniquement : injecte un admin factice (refusé si NODE_ENV=production) ---
DEV_AUTH_BYPASS=true

# --- Rétention (jours) ---
RETENTION_DAYS=183
