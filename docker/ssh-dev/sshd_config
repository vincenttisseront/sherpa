Port 22
HostKey /var/lib/ssh-dev/ssh_host_ed25519_key
PermitRootLogin no
PasswordAuthentication yes
PubkeyAuthentication yes
KbdInteractiveAuthentication no
AllowUsers deploy
# Redirection vers le socket Docker de l'hôte (API Docker de la plateforme) et SFTP (fichiers des releases).
AllowStreamLocalForwarding yes
AllowTcpForwarding no
X11Forwarding no
Subsystem sftp internal-sftp
